# Copy to .env and fill in. Never commit .env.
APP_ENV=development
# Comma-separated list of origins allowed by CORS (localhost + your Vercel URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app

# Wazuh Manager API (default port 55000). Credentials stay server-side only.
WAZUH_MANAGER_URL=https://wazuh-manager.example:55000
WAZUH_MANAGER_USER=
WAZUH_MANAGER_PASSWORD=

# Wazuh Indexer API (OpenSearch, default port 9200)
WAZUH_INDEXER_URL=https://wazuh-indexer.example:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=

# Set to true only if your Wazuh uses a trusted CA; false for self-signed lab certs
WAZUH_VERIFY_SSL=true
WAZUH_TIMEOUT_SECONDS=10

# Secret used to verify session JWTs (HS256) issued by the auth module. Min 32 chars. Empty = all protected endpoints return 503.
AUTH_JWT_SECRET=
AUTH_COOKIE_NAME=fs_session
