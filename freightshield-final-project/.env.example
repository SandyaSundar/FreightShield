# Public browser settings. Local development connects directly to the backend.
VITE_API_BASE_URL=http://localhost:8000/api
# Google OAuth Web client ID (public). Must equal GOOGLE_CLIENT_ID in backend/.env. No Client Secret belongs in the frontend.
VITE_GOOGLE_CLIENT_ID=

# Optional encrypted integration-secret vault master key (64 hex chars)
FREIGHTSHIELD_VAULT_MASTER_KEY=
