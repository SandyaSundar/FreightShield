# Copy to .env and fill in only values you configure. Never commit .env.
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Required for production sign-in; create with a cryptographically secure generator (32+ chars).
AUTH_JWT_SECRET=
# Google OAuth *Web client ID* (public value, same as VITE_GOOGLE_CLIENT_ID). The Google Identity Services ID-token flow
# used here does NOT need a Client Secret: do not put one in this file.
GOOGLE_CLIENT_ID=
# Google self-registration. New accounts always get the standard "user" role (hard-coded, not configurable).
# Set false to return to invite-only (admin-provisioned) sign-in.
SELF_SIGNUP_ENABLED=true
AUTH_COOKIE_NAME=fs_session
AUTH_TOKEN_TTL_MINUTES=60
AUTH_JWT_ISSUER=freightshield
AUTH_JWT_AUDIENCE=freightshield-api
CSRF_COOKIE_NAME=fs_csrf

# Wazuh credentials remain on this backend.
WAZUH_MANAGER_URL=
WAZUH_MANAGER_USER=
WAZUH_MANAGER_PASSWORD=
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_VERIFY_SSL=true
WAZUH_TIMEOUT_SECONDS=10

DATABASE_PATH=data/freightshield.db
DETECTION_LOOKBACK_SECONDS=900
DETECTION_INTERVAL_SECONDS=0
DETECTION_MAX_EVENTS=5000
DETECTION_NOTIFY_MIN_SEVERITY=medium

# Optional AI agents. Keep all provider keys server-side.
OPENAI_API_KEY=
EXA_API_KEY=
AI_TIMEOUT_SECONDS=180
AI_MAX_CONCURRENT=2

# Optional threat-intelligence sources.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
TI_TIMEOUT_SECONDS=8
TI_CACHE_TTL_SECONDS=86400
TI_MAX_LOOKUPS_PER_SCAN=25
TI_VT_PER_MINUTE=4
TI_LOOKBACK_SECONDS=86400

# Incident response stays disabled until an operator reviews and enables it.
IR_EXECUTION_ENABLED=false
IR_AR_BLOCK_COMMAND=firewall-drop
IR_AR_UNBLOCK_COMMAND=
IR_AR_ISOLATE_COMMAND=
IR_AR_UNISOLATE_COMMAND=
IR_PROTECTED_IPS=

# Email remains disabled until intentionally configured.
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10
NOTIFY_ESCALATION_EMAILS=
NOTIFY_APP_URL=
NOTIFY_INTERVAL_SECONDS=300
NOTIFY_EMAIL_MAX_ATTEMPTS=3

HUNT_MAX_EVENTS=5000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
MAX_BODY_BYTES=1048576
TRUST_PROXY=false
# Phase 11 encrypted API-key vault: generate with python -m scripts.generate_vault_key
# Keep this 32-byte key outside the database and never commit it.
FREIGHTSHIELD_VAULT_MASTER_KEY=
